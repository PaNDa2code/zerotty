+        0 => .remove,
+        1 => .set,
+        2 => .@"error",
+        3 => .indeterminate,
+        4 => .pause,
+        else => return,
+    };
+
+    const progress_str = it.next() orelse "0";
+    const progress_int = std.fmt.parseInt(u32, progress_str, 10) catch return;
+
+    out.pushAssumeCapacity(.{ .set_progress = .{
+        .state = progress_state,
+        .value = @intCast(@min(progress_int, 100)),
+    } });
 }
 

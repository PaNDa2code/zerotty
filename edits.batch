+            .change_bg => |c| writer.print("Action.change_bg({?})", .{c}),
+
+            .set_charset => |chr| writer.print("Action.set_charset({s})", .{@tagName(chr)}),
+
+            else => writer.print("Action.{s}", .{@tagName(self)}),
+        };
+    }
